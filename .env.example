# ==============================================================================
# Environment Configuration for sBLOOM Template & Content Hub
# Copy this file to .env or .env.local:
#   cp .env.example .env
# ==============================================================================

# Server / Deployment
HOST_PORT=9600
NODE_ENV=development

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database Connections (Prisma Configuration)
# ------------------------------------------------------------------------------
# DATABASE_URL:
#   Used by Prisma Client for application runtime queries.
#   Recommended: Supabase Transaction Pooler URL (Port 6543) with ?pgbouncer=true
#   Format: postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL:
#   Used by Prisma CLI for migrations, introspection, and advisory locking.
#   Must be direct session connection (Port 5432).
#   Format: postgresql://postgres:[DB-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL="postgresql://postgres:[DB-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# Supabase API & Authentication Keys
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL:
#   Your Supabase Project API URL (Accessible from client and server)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"

# NEXT_PUBLIC_SUPABASE_ANON_KEY:
#   Public anonymous API key safe for browser exposure with RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# SUPABASE_SERVICE_ROLE_KEY:
#   PRIVILEGED administrative service role key.
#   CRITICAL: Server-side ONLY! NEVER expose this key in client-side code or git.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# Supabase Storage Configuration
# ------------------------------------------------------------------------------
# SBLOOM_STORAGE_BUCKET:
#   Authoritative canonical private storage bucket dedicated to sBLOOM Template & Content Hub.
SBLOOM_STORAGE_BUCKET="sBLOOM_templateshub"

