{
  "name": "sbloom-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@sbloom/frontend",
    "build": "npm run build --workspace=@sbloom/frontend",
    "start": "npm run start --workspace=@sbloom/frontend",
    "lint": "npm run lint --workspace=@sbloom/frontend",
    "test": "npm run test --workspace=@sbloom/frontend",
    "test:e2e": "node apps/frontend/test-e2e.js"
  }
}
